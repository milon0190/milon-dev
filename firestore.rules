rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /portfolio/content {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == 'k3FJEVMyBtbdGkcQCIYpReEtJzZ2';
    }
    match /{document=**} { allow read, write: if false; }
  }
}
